flowchart TD
    %% Define styles
    classDef client fill:#4FC3F7,stroke:#0277BD,color:black
    classDef auth fill:#CE93D8,stroke:#7B1FA2,color:black
    classDef backend fill:#FFD54F,stroke:#FF8F00,color:black
    classDef context fill:#AED581,stroke:#33691E,color:black
    classDef storage fill:#FF8A65,stroke:#BF360C,color:black
    classDef middleware fill:#F48FB1,stroke:#AD1457,color:black
    classDef protection fill:#90CAF9,stroke:#1565C0,color:black

    %% Components
    Client["Next.js Client"]:::client
    SupaAuth["Supabase Auth"]:::auth
    Backend["Backend API"]:::backend
    AuthContext["Auth Context"]:::context
    Cookies["HTTP-only Cookies"]:::storage
    Middleware["Auth Middleware"]:::middleware
    AuthHooks["Auth Hooks"]:::protection
    RouteProtection["Route Protection"]:::protection

    %% Relationships
    Client <--> SupaAuth
    SupaAuth <--> Backend
    Client --> AuthContext
    SupaAuth --> Cookies
    Backend --> Middleware
    AuthContext --> AuthHooks
    Middleware --> RouteProtection
    
    %% Flow
    subgraph "Frontend"
        Client
        AuthContext
        AuthHooks
    end
    
    subgraph "Authentication"
        SupaAuth
        Cookies
    end
    
    subgraph "Backend"
        Backend
        Middleware
        RouteProtection
    end